/* SKILL */

skillBtn.addEventListener(
 "touchstart",
 e=>{

  e.preventDefault();

  if(
   stopped ||
   gameOver ||
   skillCooldown ||
   ownerTeam!=="blue" ||
   ownerIndex!==active
  )return;


  skillCooldown=true;


  const p=
  blue[active];


  let closest=
  red[0];


  red.forEach(r=>{

   if(
    Math.hypot(
     r.x-p.x,
     r.y-p.y
    )
    <
    Math.hypot(
     closest.x-p.x,
     closest.y-p.y
    )
   ){

    closest=r;

   }

  });


  let direction=
  closest.x<=p.x
  ? 1
  : -1;


  p.x+=
  direction*9;


  p.x=
  Math.max(
   6,
   Math.min(94,p.x)
  );


  p.el.style.transition=
  "transform .3s";


  p.el.style.transform=
  "translate(-50%,-50%) rotate(360deg)";


  say(
   "✨ SKILL!"
  );


  setTimeout(()=>{

   p.el.style.transform=
   "translate(-50%,-50%)";

   say("");

  },320);


  setTimeout(()=>{

   skillCooldown=false;

  },1400);

 },
 {passive:false}
);


